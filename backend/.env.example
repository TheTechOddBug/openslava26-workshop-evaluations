# API keys for cloud model providers.
# Local (Ollama) models do not require any key — just have Ollama running on localhost:11434.
#
# Any OpenAI-compatible provider works with the `openai_compat` model type: point the model's
# base_url at the provider and name its key in the model's `api_key_env`. Anthropic uses its
# own provider. Add only the keys for the providers you actually use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Google Gemini via its OpenAI-compatible endpoint
# (base_url https://generativelanguage.googleapis.com/v1beta/openai):
GEMINI_API_KEY=
